pipeline {
    agent any

    tools {
        maven 'maven'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn package -DskipTests'
            }
        }

        stage('Deploy') {
            steps {
                sshagent(['ec2-key']) {
                    sh 'scp -o StrictHostKeyChecking=no target/*.jar ubuntu@65.0.125.211:app.jar'
                    sh 'ssh -o StrictHostKeyChecking=no ubuntu@65.0.125.211 java -cp app.jar com.demo.App'
                }
            }
        }
    }

    post {
        always {
            junit 'target/surefire-reports/*.xml'
        }
    }
}